@@ -0,0 +1,47 @@
+// dump-json: C3M を読んで、頂点・UV・三角形を JSON で書き出す（Python 版との照合用）
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io/ioutil"
+	"os"
+
+	"github.com/retroplasma/flyover-reverse-engineering/pkg/fly/c3m"
+)
+
+type mesh struct {
+	V      [][3]float32         `json:"v"`
+	UV     [][2]float32         `json:"uv"`
+	Groups map[string][][3]int32 `json:"groups"`
+}
+
+func main() {
+	c3m.DisableLogs()
+	data, err := ioutil.ReadFile(os.Args[1])
+	if err != nil {
+		panic(err)
+	}
+	c, err := c3m.Parse(data)
+	if err != nil {
+		panic(err)
+	}
+	out := map[string]interface{}{"rotation": c.Header.Rotation, "translation": c.Header.Translation}
+	var ms []mesh
+	for _, m := range c.Meshes {
+		var o mesh
+		for _, v := range m.Vertices {
+			o.V = append(o.V, [3]float32{v.X, v.Y, v.Z})
+			o.UV = append(o.UV, [2]float32{v.U, v.V})
+		}
+		o.Groups = map[string][][3]int32{}
+		for k, g := range m.Groups {
+			for _, f := range g.Faces {
+				o.Groups[fmt.Sprint(k)] = append(o.Groups[fmt.Sprint(k)], [3]int32{f.A, f.B, f.C})
+			}
+		}
+		ms = append(ms, o)
+	}
+	out["meshes"] = ms
+	json.NewEncoder(os.Stdout).Encode(out)
+}
