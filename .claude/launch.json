{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "flyover-earth",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/earth.py"
      ],
      "autoPort": true,
      "port": 8000
    },
    {
      "name": "flyover-earth-r3d",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/earth.py",
        "--r3d"
      ],
      "autoPort": true,
      "port": 8000
    },
    {
      "name": "flyover-viewer",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/serve.py",
        "out"
      ],
      "autoPort": true,
      "port": 8000
    }
  ]
}
